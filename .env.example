# Copy this file to .env and replace the placeholder.
# Generate a value with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-64-character-hex-value

# Optional. Defaults to a local SQLite database when omitted.
# Example PostgreSQL URL: postgresql://user:password@localhost:5432/portfolio
# DATABASE_URL=sqlite:///app.db

# Set to 1 only for local development. Keep 0 in deployed environments.
FLASK_DEBUG=0
